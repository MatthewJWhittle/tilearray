<?xml version="1.0" encoding="UTF-8"?>
<!-- Fake local GeoServer-shaped WCS 2.0.1 capabilities for S5. Offline only. -->
<wcs:Capabilities xmlns:wcs="http://www.opengis.net/wcs/2.0"
                  xmlns:ows="http://www.opengis.net/ows/1.1"
                  version="2.0.1">
  <ows:ServiceIdentification>
    <ows:Title>Fake Local GeoServer WCS</ows:Title>
  </ows:ServiceIdentification>
  <wcs:Contents>
    <wcs:CoverageSummary>
      <wcs:CoverageId>local:demo_coverage</wcs:CoverageId>
    </wcs:CoverageSummary>
  </wcs:Contents>
  <wcs:SupportedFormat>image/tiff</wcs:SupportedFormat>
  <wcs:SupportedCRS>http://www.opengis.net/def/crs/EPSG/0/32632</wcs:SupportedCRS>
</wcs:Capabilities>
